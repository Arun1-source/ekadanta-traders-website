# ============================================================
# EKADANTA TRADERS - environment variables
# Copy this file to ".env" and fill in the real values.
#   cp .env.example .env
# NEVER commit ".env" to GitHub. It is already in .gitignore.
# On a hosting dashboard (Render, Railway, VPS...) add these
# as "Environment Variables" instead of using a .env file.
# ============================================================

# ---------- Server ----------
PORT=3000
NODE_ENV=development

# Where enquiries are delivered (this is the business inbox)
ENQUIRY_RECIPIENT=ekadantatraders.0208@gmail.com

# ---------- Email provider ----------
# "gmail"  -> Gmail SMTP using an App Password (needs a host that allows SMTP)
# "resend" -> Resend HTTPS API (works on every host, recommended for production)
EMAIL_PROVIDER=gmail

# --- Option A: Gmail SMTP (EMAIL_PROVIDER=gmail) ---
EMAIL_USER=ekadantatraders.0208@gmail.com
# 16-character Google App Password (NOT your normal Gmail password)
EMAIL_PASSWORD=YOUR_GMAIL_APP_PASSWORD
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# SMTP_SECURE is true for port 465 and false for port 587 (auto-detected)

# --- Option B: Resend (EMAIL_PROVIDER=resend) ---
EMAIL_API_KEY=YOUR_RESEND_API_KEY
# Without a verified domain, keep this exact value (Resend test sender).
EMAIL_FROM=EKADANTA TRADERS <onboarding@resend.dev>

# ---------- Enquiry storage (SQLite) ----------
# Every enquiry is also saved in a local database file.
STORE_ENQUIRIES=true
DATABASE_PATH=./data/enquiries.db
# Optional: lets YOU read saved enquiries at GET /api/admin/enquiries
# (send header "Authorization: Bearer <token>"). Leave empty to disable.
# Use a long random value, e.g. run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=

# ---------- Security ----------
# Max enquiry submissions per visitor (IP) inside the time window
RATE_LIMIT_MAX=6
RATE_LIMIT_WINDOW_MINUTES=15
# Number of reverse proxies in front of the app (Render/Railway = 1,
# Cloudflare + host = 2, direct VPS without proxy = 0).
# Leave empty for automatic: 1 in production, 0 otherwise.
TRUST_PROXY_HOPS=
# Only needed if the frontend is hosted on a DIFFERENT domain than the backend.
# Comma separated, e.g. https://www.ekadantatraders.in,https://ekadantatraders.in
CORS_ALLOWED_ORIGINS=

# ---------- Cloudflare Turnstile CAPTCHA (optional but recommended) ----------
# Secret key stays on the server. Site key is public and used by the frontend.
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=

# ---------- Frontend (build-time, public values only) ----------
# Leave empty when the frontend and backend run on the same domain.
# Set to the backend URL (no trailing slash) if they are on different domains.
VITE_API_URL=
